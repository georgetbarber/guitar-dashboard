rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'instrument', 'dailyMinutes', 'tonicName', 'mode', 'theme',
          'reducedMotion', 'diagnosticComplete', 'startingBaseline'
        ])
        && settings.instrument in ['electric', 'acoustic']
        && settings.dailyMinutes is int
        && settings.dailyMinutes >= 10
        && settings.dailyMinutes <= 90
        && settings.tonicName is string
        && settings.tonicName.size() <= 8
        && settings.mode is string
        && settings.mode.size() <= 32
        && settings.theme in ['light', 'dark']
        && settings.reducedMotion is bool
        && settings.diagnosticComplete is bool
        && settings.startingBaseline in ['repair', 'some', 'secure'];
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'activeUnitId', 'completedActivityIds', 'settings',
          'settingsUpdatedAt', 'lastReflection', 'deletedSketchIds', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.activeUnitId is string
        && data.activeUnitId.size() <= 64
        && data.completedActivityIds is list
        && data.completedActivityIds.size() <= 5000
        && validSettings(data.settings)
        && data.settingsUpdatedAt is string
        && data.settingsUpdatedAt.size() <= 40
        && data.lastReflection is string
        && data.lastReflection.size() <= 20000
        && data.deletedSketchIds is map
        && data.deletedSketchIds.keys().size() <= 2000
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function validEvidence(data, evidenceId) {
      return data.keys().hasOnly([
          'id', 'competencyId', 'source', 'assistance', 'context',
          'outcome', 'occurredAt', 'activityId',
          // method, artifactId and retracts are optional: records written before
          // they existed stay valid, and hasOnly permits a subset.
          'method', 'artifactId', 'retracts', 'localDate',
          'checkId', 'contentVersion', 'response'
        ])
        && (
          (!('method' in data) || data.method == 'self-reported')
            && !('checkId' in data) && !('contentVersion' in data) && !('response' in data)
          || ('method' in data) && data.method == 'exact-answer'
            && ('checkId' in data) && data.checkId is string && data.checkId.size() <= 160
            && ('contentVersion' in data) && data.contentVersion is int
            && data.contentVersion >= 1 && data.contentVersion <= 1000
            && ('response' in data) && data.response is string && data.response.size() <= 80
            && data.source == 'recognition'
            && data.assistance in ['none', 'hint']
            && data.outcome in ['successful', 'retry']
            && data.context is map
            && ('key' in data.context) && data.context.key is string
            && ('mode' in data.context) && data.context.mode in ['major', 'minor', 'dorian', 'mixolydian', 'blues']
        )
        && (!('localDate' in data) || (data.localDate is string && data.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('artifactId' in data) || (data.artifactId is string && data.artifactId.size() <= 160))
        && (!('retracts' in data) || (data.retracts is string && data.retracts.size() <= 160))
        && data.id == evidenceId
        && data.id is string
        && data.id.size() <= 160
        && data.competencyId is string
        && data.competencyId.size() <= 160
        && data.source in ['recognition', 'production', 'performance', 'transfer', 'creation', 'reflection']
        && data.assistance in ['none', 'hint', 'reveal', 'guided']
        && data.context is map
        && data.context.keys().hasOnly(['key', 'mode', 'fretRegion', 'tempo', 'instrument'])
        && data.outcome in ['successful', 'partial', 'retry']
        && data.occurredAt is string
        && data.occurredAt.size() <= 40
        && data.activityId is string
        && data.activityId.size() <= 160;
    }

    function validSketch(data, sketchId) {
      return data.keys().hasOnly([
          'id', 'name', 'intention', 'tags', 'tempo', 'metre', 'key', 'mode',
          'chords', 'melody', 'rhythmPattern', 'bassMovement', 'sections', 'notes',
          'ambiguityNotes', 'takes', 'revisions', 'reflections', 'status',
          'createdAt', 'updatedAt', 'fieldUpdatedAt'
        ])
        && data.id == sketchId
        && data.id is string
        && data.id.size() <= 160
        && data.name is string
        && data.name.size() <= 300
        && data.intention is string
        && data.intention.size() <= 5000
        && data.tags is list
        && data.tags.size() <= 100
        && data.tempo is number
        && data.tempo >= 20
        && data.tempo <= 400
        && data.metre in ['4/4', '3/4', '6/8']
        && (data.key == null || (data.key is string && data.key.size() <= 16))
        && (data.mode == null || (data.mode is string && data.mode.size() <= 32))
        && data.chords is list
        && data.chords.size() <= 512
        && data.melody is list
        && data.melody.size() <= 4096
        && data.rhythmPattern is string
        && data.rhythmPattern.size() <= 20000
        && data.bassMovement is string
        && data.bassMovement.size() <= 20000
        && data.sections is list
        && data.sections.size() <= 128
        && data.notes is string
        && data.notes.size() <= 200000
        && data.ambiguityNotes is string
        && data.ambiguityNotes.size() <= 20000
        && data.takes is list
        && data.takes.size() <= 200
        && data.revisions is list
        && data.revisions.size() <= 500
        && data.reflections is list
        && data.reflections.size() <= 500
        && data.status in ['capture', 'understand', 'vary', 'arrange', 'record', 'compare', 'revise', 'finished']
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function validDate(value) {
      return value is string && value.size() <= 40;
    }

    /*
     * Feedback notes, checklist ticks and review marks (completion brief §3.1).
     * Each is its own document in its own collection, never a profile field:
     * older clients rewrite the whole profile document and would drop fields
     * they do not know. None is learning evidence. The bounds mirror NOTE_LIMITS
     * in src/v8/limits.ts.
     */
    function validFeedback(data, noteId) {
      return data.keys().hasOnly([
          'id', 'contentId', 'contentVersion', 'contentTitle', 'location', 'showing',
          'text', 'category', 'createdAt', 'localDate', 'resolvedAt', 'updatedAt', 'appVersion'
        ])
        && data.keys().hasAll(['id', 'contentId', 'contentTitle', 'showing', 'text', 'createdAt', 'localDate', 'updatedAt'])
        && data.id == noteId
        && data.id is string && data.id.size() <= 160
        && data.contentId is string && data.contentId.size() >= 1 && data.contentId.size() <= 160
        && (!('contentVersion' in data) || (data.contentVersion is int && data.contentVersion >= 1 && data.contentVersion <= 1000))
        && data.contentTitle is string && data.contentTitle.size() <= 200
        && (!('location' in data) || (data.location is string && data.location.size() <= 300))
        && data.showing is string && data.showing.size() <= 600
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 4000
        && (!('category' in data) || data.category in ['wrong-music', 'unplayable', 'confusing', 'too-hard', 'too-easy', 'sounds-bad', 'other'])
        && validDate(data.createdAt)
        && data.localDate is string && data.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('resolvedAt' in data) || data.resolvedAt == null || validDate(data.resolvedAt))
        && validDate(data.updatedAt)
        && (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 40));
    }

    function validTick(data, itemId) {
      return data.keys().hasOnly(['id', 'done', 'updatedAt'])
        && data.keys().hasAll(['id', 'done', 'updatedAt'])
        && data.id == itemId
        && data.id is string && data.id.matches('^[a-z0-9-]{3,64}$')
        && data.done is bool
        && validDate(data.updatedAt);
    }

    function validReviewMark(data, markId) {
      return data.keys().hasOnly(['id', 'contentId', 'contentVersion', 'reviewer', 'reviewedAt', 'withdrawn', 'updatedAt'])
        && data.keys().hasAll(['id', 'contentId', 'contentVersion', 'reviewer', 'reviewedAt', 'withdrawn', 'updatedAt'])
        && data.id == markId
        && data.id is string && data.id.size() <= 200
        && data.contentId is string && data.contentId.size() >= 1 && data.contentId.size() <= 160
        && data.contentVersion is int && data.contentVersion >= 1 && data.contentVersion <= 1000
        && data.id == data.contentId + '@' + string(data.contentVersion)
        && data.reviewer is string && data.reviewer.size() >= 1 && data.reviewer.size() <= 80
        && validDate(data.reviewedAt)
        && data.withdrawn is bool
        && validDate(data.updatedAt);
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId) && validProfile(request.resource.data);
      allow delete: if owns(userId);

      /*
       * OBSERVATIONS ARE IMMUTABLE.
       *
       * A record is never edited. A mistaken report is corrected by appending a
       * retraction that names the original through `retracts`, so the history
       * stays auditable rather than being quietly rewritten. The absence of an
       * update rule already denied this; it is stated here because the contract
       * was previously only implied, and an implied contract sat beside a delete
       * permission that appeared to contradict it.
       *
       * Delete exists for one purpose: erasing an account's history on request.
       * It is a deliberate, whole-history operation and is never used to amend a
       * single observation. Nothing in the client deletes an evidence document
       * during ordinary use.
       */
      match /evidence/{evidenceId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && validEvidence(request.resource.data, evidenceId);
        allow update: if false;
        allow delete: if owns(userId);
      }

      match /sketches/{sketchId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId) && validSketch(request.resource.data, sketchId);
        allow delete: if owns(userId);
      }

      // A note's words are fixed once written; only its "dealt with" state changes.
      match /feedback/{noteId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && validFeedback(request.resource.data, noteId);
        allow update: if owns(userId) && validFeedback(request.resource.data, noteId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt', 'updatedAt']);
        allow delete: if owns(userId);
      }

      match /checks/{itemId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId) && validTick(request.resource.data, itemId);
        allow delete: if owns(userId);
      }

      // Undoing a check flips `withdrawn`; checking again writes a new reviewer and date.
      match /reviews/{markId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId) && validReviewMark(request.resource.data, markId);
        allow delete: if owns(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
