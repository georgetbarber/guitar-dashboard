# Firebase web configuration is public application configuration, not a secret.
# Copy this file to .env.local after creating a Firebase web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise site key used by Firebase App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Leave empty unless Firebase Storage is set up (Blaze plan) and its rules are
# deployed. "enabled" offers cross-device sharing of finished takes. The same
# value as a GitHub repository variable also makes the release deploy storage rules.
VITE_RECORDING_SHARING=
